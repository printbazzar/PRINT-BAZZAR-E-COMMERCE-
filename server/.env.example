# ===================================================
# PRINT BAZZAR BACKEND ENVIRONMENT CONFIGURATION (.env)
# ===================================================

# Server Port (Default: 5000)
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Database Connection URLs (PostgreSQL)
# DATABASE_URL: Main pooled connection string (used by Prisma Client runtime)
# Example (Neon/Supabase pooled): postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://user:password@localhost:5432/printbazzar_db?schema=public

# DIRECT_URL: Direct unpooled connection string (required by Prisma for schema migrations)
# Example (Direct): postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DIRECT_URL=postgresql://user:password@localhost:5432/printbazzar_db?schema=public

# Cryptographic Secret for JWT Access/Refresh Tokens (Use a strong 64+ char random string)
JWT_SECRET=your_super_secret_jwt_random_signing_key_min_32_chars_long

# CORS Allowed Origins (Comma-separated URLs allowed to make API requests)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://printbazzar.online

# Frontend Client Public Base URL (Used for generating notification & order tracking links)
CLIENT_URL=http://localhost:5173

# Payment Gateway Configuration (Razorpay)
# Note: These can also be configured dynamically via Admin Settings in the database
RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_SECRET=yourRazorpaySecretKeyHere

# File Storage Configuration (Optional Cloud Storage with Supabase S3)
# If left unset, server automatically falls back to local disk storage in server/uploads/
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Third-Party Notifications & Webhooks (Optional)
WHATSAPP_WEBHOOK_URL=
SMS_GATEWAY_URL=
