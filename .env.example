# ===================================================
# PRINT BAZZAR PLATFORM ROOT ENVIRONMENT REFERENCE
# ===================================================
# This monorepo consists of:
# 1. Backend Express API: located in `server/` (requires `server/.env`)
# 2. Frontend React Client: located in `printbazzar_react/client/` (requires `client/.env`)
#
# Refer to:
# - `server/.env.example` for full backend variables
# - `printbazzar_react/client/.env.example` for frontend variables
#
# Primary Backend Variables:
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/printbazzar_db?schema=public
DIRECT_URL=postgresql://user:password@localhost:5432/printbazzar_db?schema=public
JWT_SECRET=your_super_secret_jwt_random_signing_key_min_32_chars_long
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://printbazzar.online
CLIENT_URL=http://localhost:5173

# Primary Frontend Variables:
VITE_API_URL=http://localhost:5000/api/v1
