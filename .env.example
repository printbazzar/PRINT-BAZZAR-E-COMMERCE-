# ==============================================================================
# PRINT BAZZAR E-COMMERCE PLATFORM — ENVIRONMENT VARIABLE TEMPLATE (.env.example)
# ==============================================================================
# IMPORTANT: DO NOT COMMIT REAL SECRETS OR CREDIENTALS TO VERSION CONTROL.
# Copy this file to .env (for local development) or set in server dashboard (Render/Vercel).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=development                       # 'development', 'production', or 'test'
PORT=5000                                  # Server listening port
CLIENT_URL=http://localhost:5173           # Primary frontend URL for CORS & email links
ALLOWED_ORIGINS=http://localhost:5173      # Comma-separated CORS allowed origins

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Supabase PostgreSQL via Prisma)
# ------------------------------------------------------------------------------
# Transaction pooler URL (used by Prisma Client for app connection pooling)
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true

# Direct connection URL (used by Prisma CLI for migrations & DDL schema operations)
DIRECT_URL=postgresql://user:password@host:5432/postgres

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY SECRETS
# ------------------------------------------------------------------------------
# JWT Secrets (Must be unique, strong, 32+ char random strings in production)
JWT_ACCESS_SECRET=your-32-character-access-token-secret-here
JWT_REFRESH_SECRET=your-32-character-refresh-token-secret-here

# Token Lifespans & Rotation
REFRESH_TOKEN_ROTATION_GRACE_SECONDS=10    # Reuse grace window for concurrent requests (sec)

# Login Lockout & Security Hardening
PASSWORD_LOGIN_MAX_ATTEMPTS=5              # Max consecutive failed attempts before lockout
PASSWORD_LOGIN_LOCKOUT_SECONDS=900         # Lockout duration in seconds (15 minutes)

# ------------------------------------------------------------------------------
# 4. MOBILE OTP VERIFICATION HARDENING
# ------------------------------------------------------------------------------
MOBILE_OTP_ENABLED=false                    # Enable/disable mobile OTP verification
MOBILE_OTP_REQUIRED=false                   # Require OTP verification before order placement
OTP_PROVIDER=SIMULATOR                      # 'SIMULATOR', 'FAST2SMS', 'MSG91', or 'GENERIC_GATEWAY'
SMS_GATEWAY_URL=                            # HTTP Gateway URL for sending SMS OTPs
OTP_HASH_SECRET=your-32-character-otp-hash-secret-here
OTP_RATE_LIMIT_SECRET=your-32-character-otp-rate-limit-secret-here

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAY INTEGRATION (Razorpay)
# ------------------------------------------------------------------------------
# Gateway Execution Mode ('TEST' for Staging/Dev, 'LIVE' for Production)
RAZORPAY_MODE=TEST

# Test Mode Credentials (STAGING / DEVELOPMENT)
RAZORPAY_TEST_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_TEST_KEY_SECRET=your_razorpay_test_secret_here
RAZORPAY_TEST_WEBHOOK_SECRET=your_razorpay_test_webhook_secret_here

# Live Mode Credentials (PRODUCTION ONLY)
RAZORPAY_LIVE_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_LIVE_KEY_SECRET=your_razorpay_live_secret_here
RAZORPAY_LIVE_WEBHOOK_SECRET=your_razorpay_live_webhook_secret_here

# Legacy / Fallback Razorpay Keys (Optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 6. EXTERNAL INTEGRATIONS & OAUTH
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Client ID (for Customer & Admin Google Sign-In)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Email Gateway (Resend or Webhook)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Print Bazzar <orders@printbazzar.online>
EMAIL_WEBHOOK_URL=

# WhatsApp & Webhook Notifications
WHATSAPP_WEBHOOK_URL=
ADMIN_NOTIFICATION_WEBHOOK_URL=

# Cron / Automation Security Secret
CRON_SECRET=your-cron-endpoint-authorization-secret-here
