{
  "version": 2,
  "buildCommand": "cd printbazzar_react/client && npm install && npm run build",
  "outputDirectory": "printbazzar_react/client/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://api.printbazzar.online/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
